# ---------------------------------------------------------------------------
# Digital Twin — AI chat configuration
#
# With NO key set, the twin runs in offline mode: it answers from a
# deterministic keyword responder built from src/lib/data.ts. Everything works,
# it's just not generative.
#
# To turn on the real model, pick a provider and paste a key below.
# Google Gemini is the default and has a genuinely free API tier.
# ---------------------------------------------------------------------------

# google | groq | openrouter | openai      (default: google)
AI_PROVIDER=google

# Google      → https://aistudio.google.com/apikey       (free tier)
# Groq        → https://console.groq.com/keys            (free tier)
# OpenRouter  → https://openrouter.ai/keys               (free models available)
AI_API_KEY=

# Optional — override the provider's default model
# AI_MODEL=gemini-2.5-flash

# Optional — point at any other OpenAI-compatible endpoint
# AI_BASE_URL=
